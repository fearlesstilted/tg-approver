# Telegram bot token from @BotFather
TELEGRAM_TOKEN=123456789:AAF...your-token-here

# Your personal chat ID from @userinfobot
TELEGRAM_CHAT_ID=123456789

# Port for the local approval server (hooks poll it on localhost)
APPROVER_PORT=8877

# Working directory for /prompt tasks (defaults to where the server was started)
#PROJECT_DIR=/home/you/projects/my-app

# Claude binary, if not on PATH (Windows: full path to claude.cmd)
#CLAUDE_BIN=claude

# How long /prompt waits for Claude to finish, seconds (default 1800)
#PROMPT_TIMEOUT=1800
